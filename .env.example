# BILA environment variables. Copy to .env (never commit .env).
# The phase in brackets is when each variable is first used.

# [M3] Network. Testnet only unless the owner explicitly decides otherwise.
NEAR_NETWORK=testnet
# NEAR deprecated its own near.org RPC endpoints (heavily rate-limited), so do not use
# rpc.testnet.near.org. Pick a provider from https://docs.near.org/api/rpc/providers
# (FastNEAR is listed for testnet) and re-check that list before relying on it.
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# [M3] Set after the first testnet deploy, e.g. bila-core.<your-dev-account>.testnet
BILA_CONTRACT_ID=
# [M2] The owner's testnet account id. This is public information, not a secret.
BILA_OWNER_ACCOUNT_ID=

# Private keys NEVER go in this file, in the repo, in logs, or in chat.
# They live in ~/.near-credentials (written by the NEAR tooling) or in
# GitHub / Codespaces secrets.

# [M4] MCP server
MCP_PORT=3333
# Generate with: openssl rand -hex 32   (store as a secret, never commit)
MCP_AUTH_SECRET=

# [M5, optional] Only if we add Postgres (see docs/DECISIONS.md, ADR-007)
DATABASE_URL=
